{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "G10 Agents inputs",
  "type": "object",
  "required": ["agents", "endpoint", "schema"],
  "additionalProperties": false,
  "properties": {
    "agents": {"type": "string", "description": "YAML file (relative to maya.yaml): supervisor, sub-agents, routing examples; see $defs.agents_file"},
    "endpoint": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,62}$", "description": "Model Serving endpoint name"},
    "schema": {"type": "string", "description": "Schema ('schema' or 'catalog.schema') of the registered model"},
    "model_name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,60}$", "description": "Registered model name (default: the supervisor's name)"},
    "llm_endpoint": {"type": "string", "default": "databricks-claude-sonnet-4-6",
                     "description": "Model Serving endpoint of the language model the served agents call"},
    "users": {"type": "array", "items": {"type": "string"}, "description": "Who may query the endpoint (CAN_QUERY): groups, users or service principals"},
    "scale_to_zero": {"type": "boolean", "default": true},
    "max_tools_per_agent": {"type": "integer", "minimum": 1, "maximum": 20, "default": 8},
    "max_turns": {"type": "integer", "minimum": 2, "maximum": 12, "default": 6, "description": "Tool-calling turns per agent and question"},
    "model": {"type": "string", "description": "AI Gateway model for agent_engineer (default: maya.yaml ai_gateway.model)"}
  },
  "$defs": {
    "agents_file": {
      "type": "object", "additionalProperties": false, "required": ["supervisor", "sub_agents", "routing_examples"],
      "properties": {
        "supervisor": {"$ref": "#/$defs/agent"},
        "sub_agents": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"$ref": "#/$defs/sub_agent"}},
        "routing_examples": {
          "type": "array", "minItems": 1,
          "items": {"type": "object", "additionalProperties": false, "required": ["question", "route"],
                    "properties": {"question": {"type": "string", "minLength": 5},
                                   "route": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}
        }
      }
    },
    "agent": {
      "type": "object", "additionalProperties": false, "required": ["name", "purpose"],
      "properties": {"name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,40}$"},
                     "purpose": {"type": "string", "minLength": 10, "maxLength": 1000}}
    },
    "sub_agent": {
      "type": "object", "additionalProperties": false, "required": ["name", "purpose"],
      "properties": {"name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,40}$"},
                     "purpose": {"type": "string", "minLength": 10, "maxLength": 1000},
                     "tools": {"type": "array", "items": {"type": "string", "pattern": "^(functions|lookup|genie|ops|function:[a-z0-9_]+|ops:[a-z0-9_]+)$"}}}
    }
  }
}
