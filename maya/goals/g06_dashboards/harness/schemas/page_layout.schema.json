{
  "type": "object",
  "additionalProperties": false,
  "required": ["page", "tiles", "filters"],
  "properties": {
    "page": {"type": "string", "description": "page id, exactly as given"},
    "tiles": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "title", "metric_view", "measures"],
        "properties": {
          "kind": {"enum": ["counter", "line", "bar", "table"]},
          "title": {"type": "string", "minLength": 3, "maxLength": 80},
          "metric_view": {"type": "string", "pattern": "^[^.]+\\.[^.]+\\.[^.]+$"},
          "measures": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string"}},
          "dimension": {"type": "string"},
          "series": {"type": "string"}
        }
      }
    },
    "filters": {"type": "array", "maxItems": 4, "items": {"type": "string"}}
  }
}
