{
  "type": "object",
  "required": ["dashboard_id", "url", "tiles", "failing", "empty", "results"],
  "properties": {
    "dashboard_id": {"type": "string"},
    "url": {"type": "string"},
    "tiles": {"type": "integer", "minimum": 1},
    "failing": {"type": "integer", "minimum": 0},
    "empty": {"type": "integer", "minimum": 0},
    "results": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["page", "tile", "rows"],
                "properties": {"rows": {"type": ["integer", "null"]}, "error": {"type": ["string", "null"]}}}
    }
  }
}
