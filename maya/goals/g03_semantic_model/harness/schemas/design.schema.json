{
  "type": "object",
  "additionalProperties": false,
  "required": ["subdomain", "pages"],
  "properties": {
    "subdomain": {"type": "string", "description": "id of the subdomain, exactly as given"},
    "pages": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "description", "assets"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 80},
          "description": {"type": "string", "minLength": 20, "maxLength": 600},
          "assets": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["asset", "confidence", "rationale"],
              "properties": {
                "asset": {"type": "string", "description": "full_name exactly as given"},
                "confidence": {"type": "number", "minimum": 0, "maximum": 1},
                "rationale": {"type": "string", "maxLength": 300}
              }
            }
          }
        }
      }
    }
  }
}
