{
  "type": "object",
  "additionalProperties": false,
  "required": ["table", "rules"],
  "properties": {
    "table": {"type": "string", "description": "the table's full name, exactly as given"},
    "rules": {
      "type": "array", "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["type", "severity", "reason"],
        "properties": {
          "type": {"enum": ["not_null", "unique", "accepted_values", "range", "expression", "row_count"]},
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,59}$"},
          "column": {"type": "string"},
          "columns": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "string"}},
          "values": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"type": ["string", "number", "boolean"]}},
          "min": {"type": "number"},
          "max": {"type": "number"},
          "expression": {"type": "string", "maxLength": 500},
          "severity": {"enum": ["critical", "warning"]},
          "reason": {"type": "string", "minLength": 5, "maxLength": 300}
        }
      }
    }
  }
}
