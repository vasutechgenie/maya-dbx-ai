{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "layers", "gaps", "ready_for_metadata"],
  "properties": {
    "summary": {"type": "string", "minLength": 20},
    "layers": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["layer", "assessment", "asset_count"],
        "properties": {
          "layer": {"type": "string"},
          "assessment": {"type": "string", "enum": ["ready", "ready_with_gaps", "not_ready"]},
          "asset_count": {"type": "integer"},
          "notes": {"type": "string"}
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["asset", "issue", "severity"],
        "properties": {
          "asset": {"type": "string", "description": "full_name of an asset from the inventory, or a layer name"},
          "issue": {"type": "string"},
          "severity": {"type": "string", "enum": ["blocking", "major", "minor"]},
          "addressed_by": {"type": "string", "description": "Goal that will address it, e.g. G1"}
        }
      }
    },
    "ready_for_metadata": {"type": "boolean"}
  }
}
