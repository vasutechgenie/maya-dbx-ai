{
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["layer", "full_name", "kind", "column_count", "has_comment", "readable"],
    "properties": {
      "layer": {"type": "string"},
      "full_name": {"type": "string", "pattern": "^[^.]+\\.[^.]+\\.[^.]+$"},
      "kind": {"type": "string", "enum": ["table", "view"]},
      "table_type": {"type": ["string", "null"]},
      "column_count": {"type": "integer", "minimum": 0},
      "has_comment": {"type": "boolean"},
      "row_count": {"type": ["integer", "null"], "minimum": 0},
      "readable": {"type": "boolean"},
      "error": {"type": ["string", "null"]},
      "last_updated": {"type": ["string", "null"]}
    }
  }
}
