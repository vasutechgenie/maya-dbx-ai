{
  "type": "object",
  "required": ["app_name", "server", "version", "operations", "clients", "max_wait_seconds", "status_tools"],
  "properties": {
    "app_name": {"type": "string"},
    "clients": {"type": "array", "items": {"type": "string"}},
    "max_wait_seconds": {"type": "integer", "maximum": 280},
    "operations": {
      "type": "array", "minItems": 1,
      "items": {"type": "object",
                "required": ["name", "tool", "description", "writes", "parameters", "job_key", "env", "timeout_minutes"],
                "properties": {"tool": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,40}$"},
                               "description": {"type": "string", "minLength": 1},
                               "parameters": {"type": "array", "items": {"type": "object", "required": ["name", "type", "description"]}}}}
    }
  }
}
