{
  "type": "object",
  "required": ["schema", "targets", "thresholds", "questions", "regression", "version", "suggestions", "coverage"],
  "properties": {
    "targets": {"type": "array", "items": {"enum": ["agent", "genie"]}},
    "thresholds": {"type": "object"},
    "questions": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["id", "question", "sql", "targets"]}
    },
    "regression": {"type": "object", "required": ["on_change", "notify", "tables"]},
    "suggestions": {"type": "array", "items": {"type": "object", "required": ["question", "sql"]}}
  }
}
