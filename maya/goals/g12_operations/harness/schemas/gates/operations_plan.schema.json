{
  "type": "object",
  "required": ["documents", "jobs", "dashboard", "notify", "version"],
  "properties": {
    "documents": {
      "type": "object", "minProperties": 2,
      "additionalProperties": {"type": "object", "required": ["title", "markdown"]}
    },
    "jobs": {"type": "array", "items": {"type": "object", "required": ["name", "problems"]}},
    "dashboard": {"type": "object", "required": ["title", "datasets"],
                  "properties": {"datasets": {"type": "array", "minItems": 1}}}
  }
}
